POSTGRES_DB=bagcollect
POSTGRES_USER=bagcollect
POSTGRES_PASSWORD=replace-with-random-password
API_HOST_PORT=3001
ADMIN_HOST_PORT=8081
STORAGE_DRIVER=cos
API_IMAGE=ghcr.io/your-account/bagcollect-api:latest
WORKER_IMAGE=ghcr.io/your-account/bagcollect-worker:latest
ADMIN_IMAGE=ghcr.io/your-account/bagcollect-admin:latest
REMBG_IMAGE=ghcr.io/your-account/bagcollect-rembg:latest
# rembg 服务端并发上限（对应 --threads，不是推理线程数）。worker 侧已串行化，保持 1。
REMBG_SERVER_CONCURRENCY=1
# 推理线程数（对应 OMP_NUM_THREADS）：保持留空，让 onnxruntime 按可用核数自行决定（实测最快）。
# 只有当 rembg 容器被 --cpus 限流、onnxruntime 会误判可用核数时，才需要填配额内的数值。
REMBG_OMP_NUM_THREADS=
# 送抠图前的降采样上限，必须对齐 REMBG_MODEL 的模型输入边长（birefnet-general-lite 为 1024）。
MATTING_INFERENCE_MAX_EDGE=1024
