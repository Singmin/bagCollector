# ---------------------------------------------------------------------------
# BagCollect 生产部署配置（宝塔服务器 + Docker Compose）
#
# 用法：在服务器上复制成 infra/.env.deploy 后填写。该文件禁止提交，
#       .gitignore 已挡住 `.env.*` 并用 `!infra/.env.*.example` 放行本模板。
#
# 这个文件同时承担两个角色，改完必须重新跑 infra/deploy.sh 才生效：
#   1) `docker compose --env-file infra/.env.deploy` 的变量插值来源
#      → 下方 POSTGRES_*、*_IMAGE 等
#   2) api / worker / migrate 容器的 env_file（compose 里写的是 .env.deploy）
#      → 下方 JWT_SECRET、COS_*、WECHAT_* 等直接注入容器
#
# 注意：DATABASE_URL / REDIS_URL / NODE_ENV / STORAGE_DRIVER 由 compose 的
#       environment 段直接拼好并覆盖，不需要也不应该写在这里 ——
#       容器要连的是 compose 网络里的 postgres / redis 服务名，不是 127.0.0.1。
# ---------------------------------------------------------------------------

# ---------- 镜像（日常不用手改；GitHub Actions 会用本地 commit SHA 标签覆盖）----------
# 生产流水线会在服务器构建 bagcollect-api:<commit> / bagcollect-admin:<commit>，
# 并通过 shell 环境变量覆盖下面两个占位值。只有脱离 GitHub Actions 手工执行
# deploy.sh 时，才需要把它们改成服务器上确实存在的本地镜像标签，或远程镜像地址。
# 注意：这里**没有** WORKER_IMAGE —— api 与 worker 跑的是同一个镜像，
# compose 里两个服务用不同的 command 区分角色，理由见 infra/Dockerfile 顶部注释。
# 旧的 .env.deploy 里如果还留着 WORKER_IMAGE=... 一行，删不删都不影响运行（已无引用）。
API_IMAGE=bagcollect-api:replace-with-commit-sha
ADMIN_IMAGE=bagcollect-admin:replace-with-commit-sha

# ---------- 对外端口 ----------
# 只绑 127.0.0.1，公网访问一律走宝塔 Nginx 反代，不要改成 0.0.0.0。
API_HOST_PORT=3001
ADMIN_HOST_PORT=8081

# ---------- 数据库端口映射到宿主机 loopback ----------
# 仅为了让你能用宝塔/Navicat 连上去看数据；容器内部仍然走服务名互相访问。
# 如果宿主机 5432 / 6379 已被占用（例如宝塔软件商店装过原生 PostgreSQL 或 Redis），
# compose 会报 port is already allocated —— 把这里改成 15432 / 16379 即可，
# 不影响任何应用逻辑。
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# ---------- PostgreSQL（compose 内的 postgres 容器，非宝塔软件商店版）----------
POSTGRES_DB=bagcollect
POSTGRES_USER=bagcollect
# 密码必须只含 [A-Za-z0-9]，不要用 @ : / # ? 等字符 ——
# compose 会把它直接拼进 postgresql://user:pass@host/db 连接串，特殊字符会破坏 URL。
# 生成命令：openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-url-safe-random-password

# ---------- API ----------
# 对外真实 HTTPS 地址（不带结尾斜杠）。
# 注意：这个值**不在生产主链路上** —— 只有 STORAGE_DRIVER=local 时才会被用到
# （uploads.service.ts 与 cos.service.ts 都在 isLocal() 分支里才引用它）。
# 生产强制 STORAGE_DRIVER=cos，图片全部走 COS 直传与签名地址，所以这里填错了
# 不影响上传/抠图；但建议还是填成真实域名，切回本地存储时才不会出问题。
API_PUBLIC_URL=https://api.example.com
# 必须 ≥32 字符。生成命令：openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_DAYS=30

# ---------- 微信小程序 ----------
# 生产必须 WECHAT_AUTH_MOCK=false，且 AppID/AppSecret 必填，
# 否则 API 启动时 zod 校验直接失败（这是刻意的，避免线上用 mock 登录）。
WECHAT_AUTH_MOCK=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---------- 腾讯云 COS + 数据万象（worker 的硬性要求）----------
# COS_BUCKET 必须带 APPID 后缀，例如 bagcollect-1313112155。
# 密钥建议用 CAM 子账号，策略必须含 cos:PutObject / GetObject / HeadObject /
# DeleteObject 与 ci:CreateS3AIPicMattingJob（每个抠图能力各自一条 ci action，
# 互不通用）。完整策略见 docs/cam-policy-cos-ci.json 与 docs/TENCENT_CLOUD_SETUP.md。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
# 图片直连模式（ASSET_URL_MODE=public）下作为图片域名：CDN 加速域名优先（需已备案
# 域名 + HTTPS 证书 + CNAME 到腾讯云 CDN，回源该桶），留空退回桶默认域名
#（bucket-appid.cos.region.myqcloud.com，自带 HTTPS 无需备案）。
COS_PUBLIC_HOST=
COS_STS_DURATION_SECONDS=600

# ---------- 图片 URL 形态 ----------
# proxy（默认）= 图片走 API 域名代理，桶保持私有读；小程序端要走 downloadFile 队列，
#               真机实测整页出图要 9s（API 中转一跳 + 4 并发限流叠加）。
# public       = 桶开放公有读，图片用 COS/CDN 域名直连，<image> 并发加载且缓存长期
#               命中（key 带 v{n} 版本，上传时已带 immutable Cache-Control）。
# 切 public 前的检查单（控制台操作，见 docs/IMAGE_PIPELINE.md「CDN 直连」）：
#   ① 桶权限改为公有读；② 小程序后台 downloadFile 合法域名加上图片域名；
#   ③ 生产验证：curl -I 图片 URL 返回 200 且 Cache-Control 带 max-age。
ASSET_URL_MODE=proxy

# ---------- 抠图（数据万象）----------
# AIPicMatting=通用抠图 0.02 元/次（当前），GoodsMatting=商品抠图 0.01 元/次。
# 切换只改这一行，不需要改代码。理由见 docs/TENCENT_CI_MATTING.md 第 7.2 节。
CI_MATTING_PROCESS=AIPicMatting
CI_MATTING_TIMEOUT_MS=60000
CI_MATTING_MAX_RESPONSE_BYTES=83886080
CI_MATTING_MAX_CONCURRENCY=4
CI_MATTING_SIGN_EXPIRES_SECONDS=600
# 可重试失败（超时 / 5xx / 429 / 网络中断）的额外尝试次数。
# 每次重试都会重新计费，不要调大。
CI_MATTING_RETRY=1
# strict=尺寸不一致直接判失败；rescale=宽高比一致时缩放回来，不一致仍判失败。
CI_MATTING_SIZE_MODE=rescale
# worker 的队列并发，决定同时有几张图在等万象返回。
WORKER_CONCURRENCY=2

# ---------- 业务配额 ----------
# MAX_DAILY_MATTING 直接决定万象账单：0.02 元/次 × 25 = 单用户 0.50 元/天上限。
# 注意它是「建档快照」，只对新用户生效，改这里不会动存量用户。
MAX_COLLECTIBLES_PER_USER=500
MAX_STORAGE_BYTES=5368709120
MAX_DAILY_MATTING=25
MAX_UPLOAD_BYTES=31457280
MAX_IMAGE_PIXELS=60000000

# ---------- 运营后台初始账号 ----------
# 这两个只在手动执行 `pnpm db:seed` 建管理员时读取，不进 api/worker 容器，
# 所以放在这里只是图个集中。建完账号后建议从本文件删掉密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-before-production
