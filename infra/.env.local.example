# Host-run API and Worker use the persistent development services.
DATABASE_URL=postgresql://bagcollect:bagcollect_local@127.0.0.1:5432/bagcollect
REDIS_URL=redis://127.0.0.1:6379

# Integration tests use separate ephemeral services and can be reset safely.
TEST_DATABASE_URL=postgresql://bagcollect:bagcollect_test@127.0.0.1:5433/bagcollect_test
TEST_REDIS_URL=redis://127.0.0.1:6380
