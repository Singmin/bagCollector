NODE_ENV=development
API_PORT=3001
API_PUBLIC_URL=http://127.0.0.1:3001
DATABASE_URL=postgresql://bagcollect:bagcollect@localhost:5432/bagcollect
REDIS_URL=redis://localhost:6379
TEST_DATABASE_URL=postgresql://bagcollect:bagcollect_test@localhost:5433/bagcollect_test
TEST_REDIS_URL=redis://localhost:6380
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_DAYS=30

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AUTH_MOCK=true

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=../../data/local-storage

MATTING_DRIVER=rembg
REMBG_URL=http://127.0.0.1:7000
REMBG_MODEL=birefnet-general-lite
REMBG_TIMEOUT_MS=120000
REMBG_MAX_RESPONSE_BYTES=83886080
REMBG_MAX_CONCURRENCY=1

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_PUBLIC_HOST=
COS_STS_DURATION_SECONDS=600

MAX_COLLECTIBLES_PER_USER=500
MAX_STORAGE_BYTES=5368709120
MAX_DAILY_MATTING=50
MAX_UPLOAD_BYTES=31457280
MAX_IMAGE_PIXELS=60000000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-before-production
