NODE_ENV=development
API_PORT=3001
API_PUBLIC_URL=http://127.0.0.1:3001
DATABASE_URL=postgresql://bagcollect:bagcollect@localhost:5432/bagcollect
REDIS_URL=redis://localhost:6379
TEST_DATABASE_URL=postgresql://bagcollect:bagcollect_test@localhost:5433/bagcollect_test
TEST_REDIS_URL=redis://localhost:6380
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_DAYS=30

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AUTH_MOCK=true

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=../../data/local-storage

# 注意：worker 的抠图走腾讯云数据万象，启动时强制要求 STORAGE_DRIVER=cos 且 COS_* 必填。
# 因此上面保持 local 时，pnpm dev:worker 会在配置校验处直接失败（预期行为，不是 bug）；
# 要跑通图片链路就把 STORAGE_DRIVER 改成 cos，并在下面填入真实的 COS 凭据。

# 数据万象抠图。Worker 只有这一条抠图路径，没有其它后端可选。
# GoodsMatting=商品抠图，0.01 元/次；AIPicMatting=通用抠图，0.02 元/次。
# 两者调用方式与响应格式一致，只有计费和主体识别策略不同，可随时切换。
# 默认取通用抠图：真实输入是用户随手拍、手工裁剪的照片，背景常有桌面/床铺/地板，
# 通用抠图对杂乱背景宽容得多（详见 docs/TENCENT_CI_MATTING.md 第 7.2 节 A/B 实测）。
# 代价是单价翻倍，且细结构（细绳、细带）可能被侵蚀，因此 MAX_DAILY_MATTING 同步减半。
CI_MATTING_PROCESS=AIPicMatting
CI_MATTING_TIMEOUT_MS=60000
CI_MATTING_MAX_RESPONSE_BYTES=83886080
CI_MATTING_MAX_CONCURRENCY=4
CI_MATTING_SIGN_EXPIRES_SECONDS=600
# 可重试失败（超时、5xx、429、网络中断）的额外尝试次数。每次重试都会重新计费，不要调大。
CI_MATTING_RETRY=1
# 万象返回画布与裁剪图尺寸不一致时：strict=直接判失败；rescale=宽高比一致时缩放回来，不一致仍判失败。
# 2026-09-22 真实样本实测：万象在 center-layout=0 下按原画布 1:1 返回（1280x1707 进，1280x1707 出），
# 因此这里保持 rescale —— 1:1 时它是空操作，而异尺寸时比 strict 更稳（不会白白判失败）。
# 详见 docs/TENCENT_CI_MATTING.md 第 7.1 节。
CI_MATTING_SIZE_MODE=rescale

# 私有 COS 桶。下面四项是 worker 的硬性要求（抠图要先有 COS 上的裁剪图）。
# COS_BUCKET 必须带 APPID 后缀，例如 bagcollect-1250000000。
# 这四项怎么从腾讯云控制台拿到手，见 docs/TENCENT_CLOUD_SETUP.md（含可直接粘贴的权限策略）。
# 建议使用 CAM 子账号密钥，并为其补上 cos:PutObject、cos:GetObject、cos:HeadObject、
# cos:DeleteObject、ci:CreateGoodsMattingJob；不要使用主账号永久密钥。
# （注意：不要往策略里加 sts:GetFederationToken —— STS 的 GetFederationToken 不经过 CAM
#   鉴权，它不是合法的 CAM action，填进去策略校验会直接判为无效。）
# 绑定万象并开通抠图服务是在控制台按桶操作的，与密钥无关。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
# 图片直连模式（ASSET_URL_MODE=public）下作为图片域名：CDN 加速域名或桶默认域名，留空用桶默认域名。
COS_PUBLIC_HOST=
COS_STS_DURATION_SECONDS=600

# 图片对外的 URL 形态（详见 docs/IMAGE_PIPELINE.md「CDN 直连」一节）：
#   proxy（默认）= 走 API 域名代理（/api/assets/file?token=...），桶保持私有读，
#                  但每张图都要 API 中转 COS 一跳，小程序端还得走 downloadFile 队列；
#   public       = 桶开放公有读，图片用 COS/CDN 域名直连（COS_PUBLIC_HOST），
#                  URL 永不变化可长缓存，小程序 <image> 并发直载。
# 切 public 前必须：桶改公有读 + 小程序后台把图片域名加进 downloadFile 合法域名。
ASSET_URL_MODE=proxy

MAX_COLLECTIBLES_PER_USER=9999
MAX_STORAGE_BYTES=5368709120
MAX_DAILY_MATTING=25
MAX_UPLOAD_BYTES=31457280
MAX_IMAGE_PIXELS=60000000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-before-production
