<view class="tab-shell">
  <view class="tab-bar">
    <button class="tab-item {{selected === 0 ? 'is-active' : ''}}" data-index="0" bindtap="switchTab">
      <text class="tab-icon">▱</text><text>陈列</text>
    </button>
    <view class="add-slot"><button class="add-button" bindtap="add" aria-label="添加收藏">＋</button></view>
    <button class="tab-item {{selected === 1 ? 'is-active' : ''}}" data-index="1" bindtap="switchTab">
      <text class="tab-icon">▦</text><text>全部收藏</text>
    </button>
  </view>
</view>
