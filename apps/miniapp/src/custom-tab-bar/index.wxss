.tab-shell { position: fixed; z-index: 900; left: 0; right: 0; bottom: 0; padding: 0 28rpx calc(env(safe-area-inset-bottom) + 20rpx); pointer-events: none; }
.tab-bar { height: 112rpx; display: grid; grid-template-columns: 1fr 116rpx 1fr; align-items: center; border: 1rpx solid rgba(45,39,30,.14); border-radius: 42rpx; background: rgba(255,253,248,.94); box-shadow: 0 18rpx 60rpx rgba(44,35,24,.17); backdrop-filter: blur(24px); pointer-events: auto; }
.tab-item { min-width: 0; margin: 0; padding: 14rpx 8rpx; display: flex; flex-direction: column; gap: 2rpx; align-items: center; background: transparent; color: #8a8277; font-size: 19rpx; line-height: 1.2; }
.tab-item.is-active { color: #211f1c; font-weight: 700; }
.tab-icon { font-size: 36rpx; line-height: 1; }
.add-slot { position: relative; height: 112rpx; }
.add-button { position: absolute; z-index: 2; left: 50%; top: -38rpx; width: 104rpx; height: 104rpx; margin: 0; padding: 0; transform: translateX(-50%); display: grid; place-items: center; border: 9rpx solid #f2eee6; border-radius: 50%; background: #211f1c; color: white; box-shadow: 0 13rpx 30rpx rgba(31,27,22,.25); font: 300 58rpx/1 -apple-system, sans-serif; }
