{
  "pages": [
    { "path": "pages/showcase/index", "style": { "enablePullDownRefresh": true } },
    { "path": "pages/library/index", "style": { "enablePullDownRefresh": true, "onReachBottomDistance": 240 } }
  ],
  "subPackages": [
    {
      "root": "package-editor",
      "pages": [
        { "path": "pages/add/index" },
        { "path": "pages/crop/index", "style": { "disableScroll": true } },
        { "path": "pages/processing/index" },
        { "path": "pages/metadata/index" }
      ]
    },
    { "root": "package-library", "pages": [{ "path": "pages/detail/index" }] },
    {
      "root": "package-settings",
      "pages": [{ "path": "pages/settings/index" }, { "path": "pages/shelves/index" }]
    }
  ],
  "globalStyle": {
    "navigationStyle": "custom",
    "backgroundColor": "#f2eee6",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "custom": true,
    "color": "#777064",
    "selectedColor": "#211f1c",
    "backgroundColor": "#fffdf8",
    "list": [
      { "pagePath": "pages/showcase/index", "text": "陈列" },
      { "pagePath": "pages/library/index", "text": "全部收藏" }
    ]
  },
  "easycom": { "autoscan": true }
}
