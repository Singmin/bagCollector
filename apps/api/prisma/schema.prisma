generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ShelfTheme {
  SAGE
  AMBER
  SKY
  ROSE
  GRAPHITE
}

/* 图片处理状态机：UPLOADING → NORMALIZING → AWAITING_CROP
   →（裁剪）CROPPING → READY
   →（抠图）MATTING → READY
   任一步失败进 FAILED；READY / FAILED 都可以再发起裁剪或抠图（版本号 +1） */
enum ProcessingStatus {
  UPLOADING
  NORMALIZING
  AWAITING_CROP
  CROPPING
  MATTING
  READY
  FAILED
}

enum ImageSide {
  FRONT
  BACK
}

enum AssetKind {
  ORIGINAL
  STANDARD
  CROPPED
  CUTOUT
  DISPLAY
  THUMBNAIL
  /* 无白边版展示图/缩略图：与 DISPLAY/THUMBNAIL 同尺寸、同裁剪，只是不加白描边。
     由 worker 在「实际加了白边」时并行派生，供用户白边开关关闭时展示。 */
  DISPLAY_PLAIN
  THUMBNAIL_PLAIN
}

enum AssetStatus {
  RESERVED
  AVAILABLE
  FAILED
}

/* 任务类型与端点一一对应：/complete → NORMALIZE，/crop → CROP，/matte → MATTING */
enum JobType {
  NORMALIZE
  CROP
  MATTING
  CLEANUP
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum OfficialBagStatus {
  DRAFT
  PUBLISHED
  OFFLINE
}

enum OfficialProcessStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/* 用户上传袋子的审核状态：待审核 → 纳入官方（APPROVED）或驳回（REJECTED） */
enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// 收藏可见性：私密收藏 / 公开展示（默认公开，存量数据同默认）
enum Visibility {
  PRIVATE
  PUBLIC
}

// 版本记录状态：PLANNED = 计划中（下期改动），DONE = 已完成上线
enum ReleaseNoteStatus {
  PLANNED
  DONE
}

model Brand {
  id        String       @id @default(cuid())
  name      String       @unique
  // 品牌展示图：存 COS objectKey，URL 由 API 按环境动态生成；key 自带 v{n} 版本避免 CDN 缓存。
  displayImageKey     String?
  displayImageVersion Int     @default(0)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  bags      OfficialBag[]
}

model User {
  id                String          @id @default(cuid())
  openid            String          @unique
  unionid           String?
  status            UserStatus      @default(ACTIVE)
  storageUsedBytes  BigInt          @default(0)
  storageQuotaBytes BigInt
  collectibleQuota  Int
  dailyMattingQuota Int
  // 白边开关：true = 展示有白边的抠图；false = 展示无白边版（默认关，即默认不显示白边）。
  // 存服务端而非本地 storage，保证换设备后偏好一致。
  whiteStrokeEnabled Boolean       @default(false)
  lastLoginAt       DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sessions          Session[]
  shelves           Shelf[]
  collectibles      Collectible[]
  tags              Tag[]
  imageAssets       ImageAsset[]
  processingJobs    ProcessingJob[]
  auditLogs         AuditLog[]
  officialClaims    OfficialClaim[]
  wishlistItems     WishlistItem[]
  matchScans        MatchScan[]
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  deviceName       String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Shelf {
  id           String        @id @default(cuid())
  userId       String
  name         String
  theme        ShelfTheme
  sortOrder    Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectibles Collectible[]

  @@unique([userId, name])
  @@unique([id, userId])
  @@index([userId, sortOrder])
}

model Collectible {
  id                String           @id @default(cuid())
  userId            String
  shelfId           String
  name              String
  notes             String           @default("")
  // 同款袋子拥有数量：>1 时卡片右上角显示 ×N 角标；存量数据由默认值补成 1
  quantity          Int              @default(1)
  // 可见性：私密收藏 / 公开展示；默认公开（存量数据同默认）
  visibility        Visibility       @default(PUBLIC)
  shelfOrder        Float            @default(0)
  processingStatus  ProcessingStatus @default(UPLOADING)
  processingError   String?
  processingVersion Int              @default(1)
  cropX             Float?
  cropY             Float?
  cropWidth         Float?
  cropHeight        Float?
  // P1：自由角度（任意角度，不再限于 90° 步进）
  cropRotation      Float?
  // P2：调色（1 = 不调整）
  cropBrightness    Float?
  cropContrast      Float?
  cropSaturation    Float?
  addedAt           DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  // 审核后台：用户上传袋子的审核状态、审核人与「纳入官方袋子」回链
  submissionStatus  SubmissionStatus @default(PENDING)
  reviewNote        String?
  reviewedById      String?
  reviewedAt        DateTime?
  promotedBagId     String?          @unique
  // 认领官方袋子得到的收藏：只引用官方袋子，图片直接读官方库（不复制、不占用户存储）
  sourceOfficialBagId String?
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelf             Shelf            @relation(fields: [shelfId, userId], references: [id, userId], onDelete: Restrict)
  tags              CollectibleTag[]
  imageSides        CollectibleImageSide[]
  imageAssets       ImageAsset[]
  processingJobs    ProcessingJob[]
  reviewedBy        Admin?           @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  promotedBag       OfficialBag?     @relation(fields: [promotedBagId], references: [id], onDelete: SetNull)
  sourceOfficialBag OfficialBag?     @relation("CollectibleSourceOfficialBag", fields: [sourceOfficialBagId], references: [id], onDelete: Restrict)

  @@unique([id, userId])
  @@index([userId, addedAt])
  @@index([userId, shelfId, shelfOrder])
  @@index([userId, processingStatus])
  @@index([submissionStatus, addedAt])
}

model Tag {
  id           String           @id @default(cuid())
  userId       String
  normalized   String
  displayName  String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectibles CollectibleTag[]

  @@unique([userId, normalized])
  @@index([userId])
}

model CollectibleTag {
  collectibleId String
  tagId         String
  collectible   Collectible @relation(fields: [collectibleId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([collectibleId, tagId])
  @@index([tagId])
}

model CollectibleImageSide {
  collectibleId String
  side ImageSide @default(FRONT)
  sourceVersion Int @default(0)
  processingVersion Int @default(0)
  publishedVersion Int?
  publishedSourceVersion Int?
  mattedSourceVersion Int?
  processingStatus ProcessingStatus @default(UPLOADING)
  processingError String?
  crop Json?
  updatedAt DateTime @updatedAt
  collectible Collectible @relation(fields: [collectibleId], references: [id], onDelete: Cascade)
  @@id([collectibleId, side])
  @@index([processingStatus, updatedAt])
}

model ImageAsset {
  id                   String      @id @default(cuid())
  userId               String
  collectibleId        String
  side                 ImageSide @default(FRONT)
  kind                 AssetKind
  status               AssetStatus @default(RESERVED)
  objectKey            String      @unique
  contentType          String
  declaredByteSize     BigInt      @default(0)
  byteSize             BigInt      @default(0)
  reservationExpiresAt DateTime?
  width                Int?
  height               Int?
  version              Int         @default(1)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectible          Collectible @relation(fields: [collectibleId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([collectibleId, kind, side, version])
  @@index([userId, collectibleId, kind])
}

model ProcessingJob {
  side ImageSide @default(FRONT)
  version Int @default(0)
  sourceVersion Int @default(0)
  id             String      @id @default(cuid())
  userId         String
  collectibleId  String
  type           JobType
  status         JobStatus   @default(QUEUED)
  idempotencyKey String      @unique
  attemptCount   Int         @default(0)
  errorMessage   String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectible    Collectible @relation(fields: [collectibleId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model Admin {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs             AuditLog[]
  officialBags          OfficialBag[]
  reviewedSubmissions   Collectible[]
  releaseNotes          ReleaseNote[]
  planItems             PlanItem[]
}

model OfficialBag {
  id            String              @id @default(cuid())
  name          String
  brandId       String?
  notes         String              @default("")
  tags          String[]            @default([])
  // 运营上传时勾选是否对图片执行抠图；只影响上传后的那次处理，不影响已生成的展示图。
  matting       Boolean             @default(false)
  sortOrder     Int                 @default(0)
  status        OfficialBagStatus   @default(DRAFT)
  processStatus OfficialProcessStatus @default(PENDING)
  processError  String?
  // 每次上传图片自增；首次上传后为 1。0 表示还没有上传过图片。
  version       Int                 @default(0)
  claimedCount  Int                 @default(0)
  publishedAt   DateTime?
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdBy     Admin?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  brand         Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  imageSides OfficialBagImageSide[]
  images        OfficialBagImage[]
  embeddings    BagEmbedding[]
  scanEmbeddings ScanEmbedding[]
  references    BagReferenceImage[]
  claims        OfficialClaim[]
  wishlistedBy  WishlistItem[]
  /* 由哪个用户上传的袋子「纳入」而来（审核后台），一个用户袋子最多纳入一次 */
  sourceCollectible Collectible?
  /* 被用户认领生成的收藏（引用官方图，不复制图片、不占用户存储） */
  claimedCollectibles Collectible[] @relation("CollectibleSourceOfficialBag")

  @@index([status, sortOrder])
}

model OfficialBagImageSide {
  officialBagId String
  side ImageSide @default(FRONT)
  sourceVersion Int @default(0)
  processingVersion Int @default(0)
  publishedVersion Int?
  publishedSourceVersion Int?
  processingStatus OfficialProcessStatus @default(PENDING)
  processingError String?
  matting Boolean @default(false)
  updatedAt DateTime @updatedAt
  officialBag OfficialBag @relation(fields: [officialBagId], references: [id], onDelete: Cascade)
  @@id([officialBagId, side])
  @@index([processingStatus, updatedAt])
}

model OfficialBagImage {
  id               String      @id @default(cuid())
  officialBagId    String
  side             ImageSide @default(FRONT)
  kind             AssetKind
  status           AssetStatus @default(AVAILABLE)
  objectKey        String      @unique
  contentType      String
  declaredByteSize BigInt      @default(0)
  byteSize         BigInt      @default(0)
  width            Int?
  height           Int?
  version          Int         @default(1)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  officialBag      OfficialBag @relation(fields: [officialBagId], references: [id], onDelete: Cascade)

  @@unique([officialBagId, kind, side, version])
  @@index([officialBagId, kind])
}

/* 官方袋子的视觉特征向量：「拍照扫描袋子」（以图搜图匹配）的数据基础。
   纯派生数据 —— 由 worker 从官方袋子图（CUTOUT 优先，其次 DISPLAY）提取，
   与所依据的图片版本绑定（sourceKind + sourceVersion）。任何入库路径漏算都会被
   worker 的定时对账补上，换图换版也会被识别并重算，因此不依赖调用方记得挂钩子。
   model 用于区分特征模型：换模型 = 全量重算，靠它做灰度与回滚。 */
model BagEmbedding {
  id            String      @id @default(cuid())
  officialBagId String
  /* 特征模型标识（如 color-shape-v1）。同一袋子每个模型最多一条向量。 */
  model         String
  /* 已 L2 归一化的特征向量：比对时点积即余弦相似度。维度由模型决定。 */
  vector        Float[]
  /* 向量提取自哪张官方图及其版本：官方图换版后据此识别并重算。 */
  sourceKind    AssetKind
  sourceVersion Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  officialBag   OfficialBag @relation(fields: [officialBagId], references: [id], onDelete: Cascade)

  @@unique([officialBagId, model])
  @@index([model])
}

model ScanEmbedding {
  id            String      @id @default(cuid())
  officialBagId String
  /* Same bag/model supports a primary vector plus independent reference vectors. */
  model         String
  referenceKey  String      @default("primary")
  colorVector   Float[]     @default([])
  /* 已 L2 归一化的特征向量：比对时点积即余弦相似度。维度由模型决定。 */
  vector        Float[]
  /* 向量提取自哪张官方图及其版本：官方图换版后据此识别并重算。 */
  sourceKind    AssetKind
  sourceVersion Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  officialBag   OfficialBag @relation(fields: [officialBagId], references: [id], onDelete: Cascade)

  @@unique([officialBagId, model, referenceKey])
  @@index([model])
}

model BagReferenceImage {
  id            String   @id @default(cuid())
  officialBagId String
  objectKey     String   @unique
  contentType   String
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  officialBag   OfficialBag @relation(fields: [officialBagId], references: [id], onDelete: Cascade)
  @@index([officialBagId])
}

model MatchScan {
  id                String   @id @default(cuid())
  userId            String
  collectibleId     String
  requestId         String
  source            String
  sourceKey         String
  sourceVersion     Int
  crop              Json?
  model             String
  settings          Json
  stage             String   @default("QUEUED")
  reason            String?
  scores            Json     @default("[]")
  compared          Int      @default(0)
  enhancement       String   @default("NOT_NEEDED")
  enhancementIssued Boolean  @default(false)
  temporaryKeys     String[] @default([])
  selectedBagId     String?
  feedback          String?
  elapsedMs         Int?
  finishedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, requestId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model ScanEnhancementUsage {
  day   String
  scope String
  count Int @default(0)
  @@id([day, scope])
}

// Independent of scan/draft lifetime. byteSize is released only after object deletion.
model LearningSample {
  id            String   @id @default(cuid())
  scanId        String?  @unique
  userId        String?
  officialBagId String?
  referenceId   String?  @unique
  origin        String   @default("SCAN")
  source        String
  model         String
  snapshot      Json
  objectKey     String?  @unique
  byteSize      BigInt   @default(0)
  hash          String?
  state         String   @default("STAGING")
  featureState  String   @default("WAITING_LABEL")
  reason        String?
  possibleDuplicate String?
  expiresAt     DateTime?
  deletedAt     DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  attempts      Int      @default(0)
  retryAt       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  features      LearningSampleFeature[]
  @@index([state, expiresAt])
  @@index([officialBagId, hash])
  @@index([featureState, retryAt])
}

model LearningSampleFeature {
  id          String @id @default(cuid())
  sampleId    String
  model       String
  vector      Float[]
  colorVector Float[]
  sample      LearningSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  @@unique([sampleId, model])
}

// 心愿袋：用户对官方袋子的「想要」标记（发现页 ♥）。袋子下架/删除时级联清除。
model WishlistItem {
  id            String      @id @default(cuid())
  userId        String
  officialBagId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  officialBag   OfficialBag @relation(fields: [officialBagId], references: [id], onDelete: Cascade)

  @@unique([userId, officialBagId])
  @@index([userId, createdAt])
}

model OfficialClaim {
  id            String      @id @default(cuid())
  userId        String
  officialBagId String
  collectibleId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  officialBag   OfficialBag @relation(fields: [officialBagId], references: [id], onDelete: Cascade)

  @@unique([userId, officialBagId])
  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  userId    String?
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
}

/* 运行时可变的应用设置（键值对）。
   与 env 的分工：env 是「部署时确定、改动要重启容器」的基础设施配置；
   这里放「运营期间要调的业务参数」—— 目前是拍照扫描匹配的判定阈值。
   落到库里是为了改了立刻生效：阈值本来就要拿真实数据反复校准，
   每调一次都去改 .env 再重启 api 容器是不可接受的。
   缺失的键由 env 的默认值兜底（见 settings.service），所以这张表初始为空也能跑。
   谁在什么时候改的交给 AuditLog，不在这里冗余。 */
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/* 版本改动记录：每次发版新增一条，正文写本次改了什么。
   版本号是给人看的自由文本（如 v1.3.0 / 10.11），不强约束格式。 */
model ReleaseNote {
  id          String            @id @default(cuid())
  version     String
  title       String
  content     String            @default("")
  status      ReleaseNoteStatus @default(PLANNED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdById String?
  createdBy   Admin?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  comments    ReleaseComment[]

  @@index([status, createdAt])
  @@index([createdAt])
}

/* 版本记录下的留言。作者存名字快照：即使管理员账号被删，历史留言仍可读。 */
model ReleaseComment {
  id            String      @id @default(cuid())
  releaseNoteId String
  authorName    String
  content       String
  createdAt     DateTime    @default(now())
  releaseNote   ReleaseNote @relation(fields: [releaseNoteId], references: [id], onDelete: Cascade)

  @@index([releaseNoteId, createdAt])
}

/* 下期改动计划：运营记下「下期要做什么」，做完打勾。 */
model PlanItem {
  id          String   @id @default(cuid())
  title       String
  done        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   Admin?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([done, createdAt])
}
