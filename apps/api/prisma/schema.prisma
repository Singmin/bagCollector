generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ShelfTheme {
  SAGE
  AMBER
  SKY
  ROSE
  GRAPHITE
}

enum ProcessingStatus {
  UPLOADING
  NORMALIZING
  AWAITING_CROP
  MATTING
  READY
  FAILED
}

enum AssetKind {
  ORIGINAL
  STANDARD
  CROPPED
  CUTOUT
  DISPLAY
  THUMBNAIL
}

enum AssetStatus {
  RESERVED
  AVAILABLE
  FAILED
}

enum JobType {
  NORMALIZE
  MATTING
  CLEANUP
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum OfficialBagStatus {
  DRAFT
  PUBLISHED
  OFFLINE
}

enum OfficialProcessStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model Brand {
  id        String       @id @default(cuid())
  name      String       @unique
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  bags      OfficialBag[]
}

model User {
  id                String          @id @default(cuid())
  openid            String          @unique
  unionid           String?
  status            UserStatus      @default(ACTIVE)
  storageUsedBytes  BigInt          @default(0)
  storageQuotaBytes BigInt
  collectibleQuota  Int
  dailyMattingQuota Int
  lastLoginAt       DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sessions          Session[]
  shelves           Shelf[]
  collectibles      Collectible[]
  tags              Tag[]
  imageAssets       ImageAsset[]
  processingJobs    ProcessingJob[]
  auditLogs         AuditLog[]
  officialClaims    OfficialClaim[]
  wishlistItems     WishlistItem[]
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  deviceName       String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Shelf {
  id           String        @id @default(cuid())
  userId       String
  name         String
  theme        ShelfTheme
  sortOrder    Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectibles Collectible[]

  @@unique([userId, name])
  @@unique([id, userId])
  @@index([userId, sortOrder])
}

model Collectible {
  id                String           @id @default(cuid())
  userId            String
  shelfId           String
  name              String
  notes             String           @default("")
  shelfOrder        Float            @default(0)
  processingStatus  ProcessingStatus @default(UPLOADING)
  processingError   String?
  processingVersion Int              @default(1)
  cropX             Float?
  cropY             Float?
  cropWidth         Float?
  cropHeight        Float?
  cropRotation      Int?
  addedAt           DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelf             Shelf            @relation(fields: [shelfId, userId], references: [id, userId], onDelete: Restrict)
  tags              CollectibleTag[]
  imageAssets       ImageAsset[]
  processingJobs    ProcessingJob[]

  @@unique([id, userId])
  @@index([userId, addedAt])
  @@index([userId, shelfId, shelfOrder])
  @@index([userId, processingStatus])
}

model Tag {
  id           String           @id @default(cuid())
  userId       String
  normalized   String
  displayName  String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectibles CollectibleTag[]

  @@unique([userId, normalized])
  @@index([userId])
}

model CollectibleTag {
  collectibleId String
  tagId         String
  collectible   Collectible @relation(fields: [collectibleId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([collectibleId, tagId])
  @@index([tagId])
}

model ImageAsset {
  id                   String      @id @default(cuid())
  userId               String
  collectibleId        String
  kind                 AssetKind
  status               AssetStatus @default(RESERVED)
  objectKey            String      @unique
  contentType          String
  declaredByteSize     BigInt      @default(0)
  byteSize             BigInt      @default(0)
  reservationExpiresAt DateTime?
  width                Int?
  height               Int?
  version              Int         @default(1)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectible          Collectible @relation(fields: [collectibleId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([collectibleId, kind, version])
  @@index([userId, collectibleId, kind])
}

model ProcessingJob {
  id             String      @id @default(cuid())
  userId         String
  collectibleId  String
  type           JobType
  status         JobStatus   @default(QUEUED)
  idempotencyKey String      @unique
  attemptCount   Int         @default(0)
  errorMessage   String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectible    Collectible @relation(fields: [collectibleId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model Admin {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  officialBags OfficialBag[]
}

model OfficialBag {
  id            String              @id @default(cuid())
  name          String
  brandId       String?
  notes         String              @default("")
  tags          String[]            @default([])
  // 运营上传时勾选是否对图片执行抠图；只影响上传后的那次处理，不影响已生成的展示图。
  matting       Boolean             @default(false)
  sortOrder     Int                 @default(0)
  status        OfficialBagStatus   @default(DRAFT)
  processStatus OfficialProcessStatus @default(PENDING)
  processError  String?
  // 每次上传图片自增；首次上传后为 1。0 表示还没有上传过图片。
  version       Int                 @default(0)
  claimedCount  Int                 @default(0)
  publishedAt   DateTime?
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdBy     Admin?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  brand         Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images        OfficialBagImage[]
  claims        OfficialClaim[]
  wishlistedBy  WishlistItem[]

  @@index([status, sortOrder])
}

model OfficialBagImage {
  id               String      @id @default(cuid())
  officialBagId    String
  kind             AssetKind
  status           AssetStatus @default(AVAILABLE)
  objectKey        String      @unique
  contentType      String
  declaredByteSize BigInt      @default(0)
  byteSize         BigInt      @default(0)
  width            Int?
  height           Int?
  version          Int         @default(1)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  officialBag      OfficialBag @relation(fields: [officialBagId], references: [id], onDelete: Cascade)

  @@unique([officialBagId, kind, version])
  @@index([officialBagId, kind])
}

// 心愿袋：用户对官方袋子的「想要」标记（发现页 ♥）。袋子下架/删除时级联清除。
model WishlistItem {
  id            String      @id @default(cuid())
  userId        String
  officialBagId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  officialBag   OfficialBag @relation(fields: [officialBagId], references: [id], onDelete: Cascade)

  @@unique([userId, officialBagId])
  @@index([userId, createdAt])
}

model OfficialClaim {
  id            String      @id @default(cuid())
  userId        String
  officialBagId String
  collectibleId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  officialBag   OfficialBag @relation(fields: [officialBagId], references: [id], onDelete: Cascade)

  @@unique([userId, officialBagId])
  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  userId    String?
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
}
